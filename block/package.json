{
  "name": "@platforma-takeda/takeda.error-correction-takeda",
  "version": "1.0.0",
  "scripts": {
    "build": "shx rm -rf ./block-pack && block-tools pack",
    "do-pack": "shx rm -f *.tgz && block-tools pack && pnpm pack && shx mv *.tgz package.tgz"
  },
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "dependencies": {
    "@platforma-sdk/model": "catalog:",
    "@platforma-takeda/takeda.error-correction-takeda.workflow": "workspace:*",
    "@platforma-takeda/takeda.error-correction-takeda.model": "workspace:*",
    "@platforma-takeda/takeda.error-correction-takeda.ui": "workspace:*"
  },
  "block": {
    "components": {
      "workflow": "@platforma-takeda/takeda.error-correction-takeda.workflow/dist/tengo/tpl/main.plj.gz",
      "model": "@platforma-takeda/takeda.error-correction-takeda.model/dist/model.json",
      "ui": "@platforma-takeda/takeda.error-correction-takeda.ui/dist"
    },
    "meta": {
      "title": "error-correction-takeda",
      "logo": "file:../logos/block-logo.png",
      "url": "https://github.com/oneTakeda/11514-platforma-blocks-error-correction-takeda",
      "support": "mailto:support@milaboratories.com",
      "description": "Custom block built for error correction based on grouping sequences based off length, and looking at abundant sequences of the same length.",
      "longDescription": "file:../docs/description.md",
      "changelog": "file:../CHANGELOG.md",
      "tags": ["tutorial"],
      "organization": {
        "name": "Takeda",
        "url": "https://www.takeda.com/",
        "logo": "file:../logos/organization-logo.png"
      }
    }
  },
  "devDependencies": {
    "@platforma-sdk/block-tools": "catalog:"
  },
  "packageManager": "pnpm@9.12.0"
}
